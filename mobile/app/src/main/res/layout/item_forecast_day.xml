<?xml version="1.0" encoding="utf-8"?>
<!--
    item_forecast_day.xml
    One row of the 7-day allergy forecast.
    In the next sprint, inflate this dynamically from a list instead of using <include>.
    For now the text is set as placeholder; override in HomeFragment when wiring real data.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="7dp">

    <!-- Day name -->
    <TextView
        android:id="@+id/tv_day_name"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="Sat"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Dominant allergen emoji -->
    <TextView
        android:id="@+id/tv_day_emoji"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:text="🌿"
        android:textSize="16sp"
        android:layout_marginStart="4dp" />

    <!-- Risk bar background -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_chip">

        <!-- Filled portion — width set via layout_weight trick with nested LinearLayout -->
        <View
            android:id="@+id/v_day_bar_fill"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:background="@color/risk_high" />

    </FrameLayout>

    <!-- Risk label -->
    <TextView
        android:id="@+id/tv_day_risk"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:text="High"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="end"
        android:textColor="@color/risk_high" />

</LinearLayout>
